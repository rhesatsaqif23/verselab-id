BETTER_AUTH_SECRET=change-me-min-32-chars-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verselab
# Optional: dedicated database for tests/integration/contract.test.ts real-DB
# suite. When set, that suite runs migrations against it and truncates its
# tables on teardown. Leave unset to skip the suite.
TEST_DATABASE_URL=
# Dev-only email transport: logs password-reset links to the console.
# Production SMTP/Resend is out of scope (see docs/08-auth-integration.md).
# Unset (or any other value) disables the forgot/reset flow.
EMAIL_TRANSPORT=console
PORT=3001
