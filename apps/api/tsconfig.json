{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["bun-types"],
    "paths": {
      "#/*": ["./src/*"],
      "@verselab/shared/*": ["../../packages/shared/src/*"]
    }
  }
}
